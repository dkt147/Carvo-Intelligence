# Port the intelligence service listens on (backend expects AI_SERVICE_URL=http://localhost:8000)
PORT=8000

# Shared secret with the backend. If empty, the service accepts unauthenticated requests
# (the backend only sends "Authorization: Bearer <key>" when AI_SERVICE_API_KEY is set).
AI_SERVICE_API_KEY=

# ---- LLM: any OpenAI-compatible provider ----
# "groq" (free tier) or "openai". Override model/base_url only if you need to.
LLM_PROVIDER=groq
LLM_MODEL=
LLM_BASE_URL=

GROQ_API_KEY=
OPENAI_API_KEY=

# ---- Embeddings for protocol retrieval ----
# "local" = free offline model via fastembed (no API key, ~130 MB one-time download).
# "openai" = text-embedding-3-small (needs OPENAI_API_KEY).
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Retrieval ----
PROTOCOLS_DIR=D:/protocolscarvo
INDEX_DIR=data/index
RETRIEVAL_TOP_K=6

LOG_LEVEL=INFO
